# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000

# ─── Public URL (required in production for CSRF origin check) ─────────────
PUBLIC_URL=http://localhost:5000   # e.g. https://xxxx.ngrok-free.app in prod

# ─── Email (Gmail App Password, NOT your Gmail password) ──────────────────
GMAIL_USER=amanthakur773298@gmail.com
GMAIL_APP_PASSWORD=dgyg gyfr urci jywm   # 16-char Google App Password

# ─── Email Domain ─────────────────────────────────────────────────────────
EMAIL_DOMAIN=iiitk.ac.in

# ─── OTP Settings ─────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
MAX_OTP_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60

# ─── InsightFace ──────────────────────────────────────────────────────────
INSIGHTFACE_MODEL=buffalo_s          # buffalo_s (fast) or buffalo_l (accurate)
FACE_CONFIDENCE_THRESHOLD=0.30

# ─── Same-Person Check ────────────────────────────────────────────────────
SAME_PERSON_THRESHOLD=0.35           # min cosine similarity between embeddings

# ─── Storage ──────────────────────────────────────────────────────────────
PHOTOS_DIR=backend/photos            # relative to project root
